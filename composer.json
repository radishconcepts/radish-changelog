{
    "name": "radishconcepts/radish-changelog",
    "description": "Release changelog from CHANGELOG.md: dashboard widget, admin page, release command and release e-mails.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "wordpress",
        "wordpress-plugin",
        "changelog",
        "release"
    ],
    "homepage": "https://github.com/radishconcepts/radish-changelog",
    "authors": [
        {
            "name": "Radish Concepts",
            "homepage": "https://www.radishconcepts.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "composer/installers": "^1.0 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "RadishConcepts\\Changelog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RadishConcepts\\Changelog\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "installer-name": "radish-changelog"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
